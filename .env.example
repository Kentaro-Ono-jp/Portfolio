# Host ports used by the isolated Compose project.
PORTFOLIO_API_PORT=58000
PORTFOLIO_WEB_PORT=53000
PORTFOLIO_POSTGRES_PORT=55432
PORTFOLIO_MINIO_PORT=59000
PORTFOLIO_RABBITMQ_PORT=55672
PORTFOLIO_IDENTITY_PORT=5556

# Host-side API tooling, Web development, and integration tests. The Web reads
# its API base URL only on the server. Keep these URLs aligned with any
# host-port overrides above.
PORTFOLIO_DATABASE_URL=postgresql+psycopg://portfolio:portfolio-local-password@127.0.0.1:55432/portfolio
PORTFOLIO_S3_MODE=local
PORTFOLIO_S3_ENDPOINT_URL=http://127.0.0.1:59000
PORTFOLIO_S3_ACCESS_KEY_ID=portfolio-local-access
PORTFOLIO_S3_SECRET_ACCESS_KEY=portfolio-local-secret
PORTFOLIO_S3_BUCKET=portfolio-documents
PORTFOLIO_S3_REGION=us-east-1
PORTFOLIO_RABBITMQ_URL=amqp://portfolio:portfolio-local-password@127.0.0.1:55672/%2F
PORTFOLIO_API_BASE_URL=http://127.0.0.1:58000
PORTFOLIO_WEB_UPSTREAM_TIMEOUT_MS=8000
PORTFOLIO_WEB_PUBLIC_BASE_URL=http://127.0.0.1:53000
PORTFOLIO_WEB_OIDC_ISSUER=http://127.0.0.1:5556/dex
PORTFOLIO_WEB_OIDC_AUTHORIZATION_URL=http://127.0.0.1:5556/dex/auth
PORTFOLIO_WEB_OIDC_DISCOVERY_URL=http://127.0.0.1:5556/dex/.well-known/openid-configuration
PORTFOLIO_WEB_OIDC_TOKEN_URL=http://127.0.0.1:5556/dex/token
PORTFOLIO_WEB_OIDC_JWKS_URL=http://127.0.0.1:5556/dex/keys
PORTFOLIO_WEB_OIDC_CLIENT_ID=reactorfront-api
PORTFOLIO_WEB_OIDC_SCOPES=openid groups offline_access
PORTFOLIO_WEB_OIDC_ALLOW_INSECURE_LOOPBACK=true
PORTFOLIO_WEB_SESSION_ABSOLUTE_SECONDS=28800
PORTFOLIO_WEB_SESSION_INACTIVITY_SECONDS=1800
PORTFOLIO_WEB_OIDC_TRANSACTION_SECONDS=300
PORTFOLIO_WEB_TOKEN_REFRESH_LEEWAY_SECONDS=30
PORTFOLIO_EVENTS_PREFETCH_COUNT=1
PORTFOLIO_EVENTS_REQUEUE_DELAY_SECONDS=0.25
PORTFOLIO_EVENTS_RECONNECT_DELAY_SECONDS=1
PORTFOLIO_OIDC_ISSUER=http://127.0.0.1:5556/dex
PORTFOLIO_OIDC_DISCOVERY_URL=http://127.0.0.1:5556/dex/.well-known/openid-configuration
PORTFOLIO_OIDC_JWKS_URL=http://127.0.0.1:5556/dex/keys
PORTFOLIO_OIDC_AUDIENCE=reactorfront-api
PORTFOLIO_OIDC_ALLOWED_ALGORITHM=RS256
PORTFOLIO_OIDC_JWKS_CACHE_SECONDS=300
PORTFOLIO_OIDC_CLOCK_SKEW_SECONDS=30
PORTFOLIO_OIDC_HTTP_TIMEOUT_SECONDS=2
PORTFOLIO_OIDC_MODE=dex
PORTFOLIO_OIDC_CAPABILITY_CLAIM=groups
PORTFOLIO_OIDC_CAPABILITY_MAPPING={"reactorfront-reviewers":["documents:submit","documents:read","reviews:write","audit:read"]}

# Host-side ML tooling uses a separate settings prefix and deliberately has no
# PostgreSQL setting. Runtime Compose values use service DNS names instead.
PORTFOLIO_ML_S3_MODE=local
PORTFOLIO_ML_S3_ENDPOINT_URL=http://127.0.0.1:59000
PORTFOLIO_ML_S3_ACCESS_KEY_ID=portfolio-local-access
PORTFOLIO_ML_S3_SECRET_ACCESS_KEY=portfolio-local-secret
PORTFOLIO_ML_S3_BUCKET=portfolio-documents
PORTFOLIO_ML_S3_REGION=us-east-1
PORTFOLIO_ML_RABBITMQ_URL=amqp://portfolio:portfolio-local-password@127.0.0.1:55672/%2F
PORTFOLIO_ML_RABBITMQ_TIMEOUT_SECONDS=5
PORTFOLIO_ML_PROMOTION_MANIFEST_PATH=apps/ml/evaluation/promoted-model-v1.json
PORTFOLIO_ML_PROMOTION_MANIFEST_SCHEMA_PATH=apps/ml/evaluation/promoted-model-v1.schema.json
PORTFOLIO_ML_EVALUATION_REPOSITORY_ROOT=.
