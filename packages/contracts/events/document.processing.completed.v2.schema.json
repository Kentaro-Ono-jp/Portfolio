{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.reactorfront.dev/contracts/events/document.processing.completed.v2.schema.json",
  "title": "Document processing completed event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "correlationId",
    "documentId",
    "jobId",
    "objectKey",
    "sourceSha256",
    "modelVersion",
    "classification",
    "confidence",
    "modelEvidence"
  ],
  "properties": {
    "eventId": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "eventType": { "const": "document.processing.completed.v2" },
    "occurredAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" },
    "correlationId": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "documentId": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "jobId": { "$ref": "common.v1.schema.json#/$defs/uuid" },
    "objectKey": { "$ref": "common.v1.schema.json#/$defs/objectKey" },
    "sourceSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "modelVersion": { "$ref": "common.v1.schema.json#/$defs/modelVersion" },
    "classification": { "$ref": "common.v1.schema.json#/$defs/classification" },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "datasetVersion",
        "datasetSha256",
        "preprocessingVersion",
        "pipelineVersion",
        "artifactSha256",
        "evaluationPolicyVersion",
        "evaluationPolicySha256",
        "evaluationReportSha256"
      ],
      "properties": {
        "status": { "const": "measured" },
        "datasetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "datasetSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "preprocessingVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pipelineVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "artifactSha256": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "evaluationPolicyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evaluationPolicySha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "evaluationReportSha256": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
