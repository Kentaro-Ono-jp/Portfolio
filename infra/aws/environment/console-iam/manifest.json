{
  "schemaVersion": 2,
  "lifecycle": {
    "staticIamOwner": "owner-admin principal",
    "deploymentMode": "read-only-consumer",
    "deploymentIamMutation": false,
    "deploymentPolicyGeneration": false,
    "deploymentQuotaCalculation": false,
    "driftMode": "fail-closed"
  },
  "ownershipTags": {
    "PortfolioEnvironment": "${ENVIRONMENT}",
    "PortfolioManaged": "true",
    "PortfolioPersistent": "true",
    "PortfolioRepository": "${REPOSITORY_IDENTITY}"
  },
  "serviceLinkedRoles": {
    "apiGateway": {
      "roleName": "AWSServiceRoleForAPIGateway",
      "serviceName": "ops.apigateway.amazonaws.com"
    },
    "ecs": {
      "roleName": "AWSServiceRoleForECS",
      "serviceName": "ecs.amazonaws.com"
    },
    "mq": {
      "roleName": "AWSServiceRoleForAmazonMQ",
      "serviceName": "mq.amazonaws.com"
    },
    "rds": {
      "roleName": "AWSServiceRoleForRDS",
      "serviceName": "rds.amazonaws.com"
    }
  },
  "managedPolicies": {
    "noelAssumeBillingReadRole": {
      "name": "ReactorFrontPortfolioNoelAssumeBillingReadRole",
      "document": "noel-assume-billing-read-role.json"
    },
    "noelDeploymentAssumeOperator": {
      "name": "ReactorFrontPortfolioNoelDeploymentAssumeOperator",
      "document": "noel-deployment-assume-operator.json"
    },
    "noelAssumeObserverRole": {
      "name": "ReactorFrontPortfolioNoelAssumeObserverRole",
      "document": "noel-assume-observer-role.json"
    },
    "operatorPermissions": {
      "name": "ReactorFrontPortfolioOperatorPermissions",
      "document": "operator-permissions.json"
    },
    "staticIamAttestation": {
      "name": "ReactorFrontPortfolioStaticIamAttestation",
      "document": "static-iam-attestation.json"
    },
    "managedEnvironmentPermissions": {
      "name": "ReactorFrontPortfolioManagedEnvironmentPermissions",
      "document": "managed-environment-permissions.json"
    },
    "managedEnvironmentResourcePermissions": {
      "name": "ReactorFrontPortfolioManagedEnvironmentResourcePermissions",
      "document": "managed-environment-resource-permissions.json"
    },
    "operatorBoundary": {
      "name": "ReactorFrontPortfolioOperatorBoundary",
      "document": "operator-boundary.json"
    },
    "taskExecution": {
      "name": "ReactorFrontPortfolioTaskExecutionPolicy",
      "document": "task-execution.json"
    },
    "apiWorkload": {
      "name": "ReactorFrontPortfolioApiWorkloadPolicy",
      "document": "api-workload.json"
    },
    "mlWorkload": {
      "name": "ReactorFrontPortfolioMlWorkloadPolicy",
      "document": "ml-workload.json"
    },
    "destroy": {
      "name": "ReactorFrontPortfolioDestroyPolicy",
      "document": "destroy.json"
    },
    "lifecycleControl": {
      "name": "ReactorFrontPortfolioLifecycleControlPolicy",
      "document": "lifecycle-control.json"
    },
    "lifecycleDestroy": {
      "name": "ReactorFrontPortfolioLifecycleDestroyPolicy",
      "document": "lifecycle-destroy.json"
    },
    "scheduler": {
      "name": "ReactorFrontPortfolioSchedulerPolicy",
      "document": "scheduler.json"
    },
    "codebuildImage": {
      "name": "ReactorFrontPortfolioCodeBuildImagePolicy",
      "document": "codebuild-image.json"
    },
    "codebuildDestroy": {
      "name": "ReactorFrontPortfolioCodeBuildDestroyPolicy",
      "document": "codebuild-destroy.json"
    }
  },
  "sourceUsers": {
    "noel_deployment": {
      "name": "ReactorFrontNoel",
      "permissions": [
        "noelAssumeBillingReadRole",
        "noelDeploymentAssumeOperator",
        "noelAssumeObserverRole"
      ],
      "inlinePolicies": [],
      "groups": [],
      "boundary": null,
      "consoleLogin": false,
      "credentialMode": "existingAccessKey"
    }
  },
  "roles": {
    "operator_deployment": {
      "name": "${NAME_PREFIX}-${ENVIRONMENT}-operator-deployment",
      "trust": "operator-trust.json",
      "permissions": [
        "operatorPermissions",
        "staticIamAttestation",
        "managedEnvironmentPermissions",
        "managedEnvironmentResourcePermissions",
        "lifecycleControl"
      ],
      "boundary": "operatorBoundary",
      "tags": {
        "PortfolioEnvironment": "${ENVIRONMENT}",
        "PortfolioManaged": "true",
        "PortfolioPersistent": "true",
        "PortfolioRepository": "${REPOSITORY_IDENTITY}",
        "PortfolioPurpose": "operator-deployment"
      }
    },
    "task_execution": {
      "name": "${NAME_PREFIX}-${ENVIRONMENT}-task-execution",
      "trust": "ecs-task-trust.json",
      "permissions": ["taskExecution"],
      "boundary": "operatorBoundary",
      "tags": {
        "PortfolioEnvironment": "${ENVIRONMENT}",
        "PortfolioManaged": "true",
        "PortfolioPersistent": "true",
        "PortfolioRepository": "${REPOSITORY_IDENTITY}",
        "PortfolioPurpose": "task-execution"
      }
    },
    "web_workload": {
      "name": "${NAME_PREFIX}-${ENVIRONMENT}-web-workload",
      "trust": "ecs-task-trust.json",
      "permissions": [],
      "boundary": "operatorBoundary",
      "tags": {
        "PortfolioEnvironment": "${ENVIRONMENT}",
        "PortfolioManaged": "true",
        "PortfolioPersistent": "true",
        "PortfolioRepository": "${REPOSITORY_IDENTITY}",
        "PortfolioPurpose": "web-workload"
      }
    },
    "api_workload": {
      "name": "${NAME_PREFIX}-${ENVIRONMENT}-api-workload",
      "trust": "ecs-task-trust.json",
      "permissions": ["apiWorkload"],
      "boundary": "operatorBoundary",
      "tags": {
        "PortfolioEnvironment": "${ENVIRONMENT}",
        "PortfolioManaged": "true",
        "PortfolioPersistent": "true",
        "PortfolioRepository": "${REPOSITORY_IDENTITY}",
        "PortfolioPurpose": "api-workload"
      }
    },
    "ml_workload": {
      "name": "${NAME_PREFIX}-${ENVIRONMENT}-ml-workload",
      "trust": "ecs-task-trust.json",
      "permissions": ["mlWorkload"],
      "boundary": "operatorBoundary",
      "tags": {
        "PortfolioEnvironment": "${ENVIRONMENT}",
        "PortfolioManaged": "true",
        "PortfolioPersistent": "true",
        "PortfolioRepository": "${REPOSITORY_IDENTITY}",
        "PortfolioPurpose": "ml-workload"
      }
    },
    "destroy": {
      "name": "${NAME_PREFIX}-${ENVIRONMENT}-destroy",
      "trust": "destroy-trust.json",
      "permissions": ["operatorPermissions", "destroy", "lifecycleDestroy"],
      "boundary": "operatorBoundary",
      "tags": {
        "PortfolioEnvironment": "${ENVIRONMENT}",
        "PortfolioManaged": "true",
        "PortfolioPersistent": "true",
        "PortfolioRepository": "${REPOSITORY_IDENTITY}",
        "PortfolioPurpose": "destroy"
      }
    },
    "scheduler": {
      "name": "${NAME_PREFIX}-${ENVIRONMENT}-scheduler",
      "trust": "scheduler-trust.json",
      "permissions": ["scheduler"],
      "boundary": "operatorBoundary",
      "tags": {
        "PortfolioEnvironment": "${ENVIRONMENT}",
        "PortfolioManaged": "true",
        "PortfolioPersistent": "true",
        "PortfolioRepository": "${REPOSITORY_IDENTITY}",
        "PortfolioPurpose": "scheduler"
      }
    },
    "codebuild_image": {
      "name": "${NAME_PREFIX}-${ENVIRONMENT}-codebuild-image",
      "trust": "codebuild-image-trust.json",
      "permissions": ["codebuildImage"],
      "boundary": "operatorBoundary",
      "tags": {
        "PortfolioEnvironment": "${ENVIRONMENT}",
        "PortfolioManaged": "true",
        "PortfolioPersistent": "true",
        "PortfolioRepository": "${REPOSITORY_IDENTITY}",
        "PortfolioPurpose": "codebuild-image"
      }
    },
    "codebuild_destroy": {
      "name": "${NAME_PREFIX}-${ENVIRONMENT}-codebuild-destroy",
      "trust": "codebuild-destroy-trust.json",
      "permissions": ["codebuildDestroy"],
      "boundary": "operatorBoundary",
      "tags": {
        "PortfolioEnvironment": "${ENVIRONMENT}",
        "PortfolioManaged": "true",
        "PortfolioPersistent": "true",
        "PortfolioRepository": "${REPOSITORY_IDENTITY}",
        "PortfolioPurpose": "codebuild-destroy"
      }
    }
  }
}
