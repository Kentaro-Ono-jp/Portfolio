{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnvironmentServiceCeiling",
      "Effect": "Allow",
      "Action": [
        "apigateway:*",
        "codebuild:*",
        "cognito-idp:*",
        "ec2:*",
        "ecs:*",
        "logs:*",
        "mq:*",
        "rds:*",
        "route53:CreateHostedZone",
        "route53:GetHostedZone",
        "route53:ListHostedZonesByName",
        "route53:ListTagsForResource",
        "scheduler:*",
        "secretsmanager:*",
        "servicediscovery:CreatePrivateDnsNamespace",
        "servicediscovery:CreateService",
        "servicediscovery:DeleteNamespace",
        "servicediscovery:DeleteService",
        "servicediscovery:GetNamespace",
        "servicediscovery:GetOperation",
        "servicediscovery:GetService",
        "servicediscovery:ListNamespaces",
        "servicediscovery:ListServices",
        "servicediscovery:ListTagsForResource",
        "servicediscovery:TagResource",
        "sts:GetCallerIdentity",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ApplicationBucketCeiling",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:${AWS_PARTITION}:s3:::${NAME_PREFIX}-${ENVIRONMENT}-documents",
        "arn:${AWS_PARTITION}:s3:::${NAME_PREFIX}-${ENVIRONMENT}-documents/*"
      ]
    },
    {
      "Sid": "StateBucketInspectionCeiling",
      "Effect": "Allow",
      "Action": ["s3:GetBucket*", "s3:GetEncryptionConfiguration"],
      "Resource": "arn:${AWS_PARTITION}:s3:::${STATE_BUCKET_NAME}"
    },
    {
      "Sid": "EnvironmentStateBucketCeiling",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:${AWS_PARTITION}:s3:::${STATE_BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "environments/${ENVIRONMENT}/terraform.tfstate",
            "environments/${ENVIRONMENT}/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "EnvironmentStateObjectCeiling",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:${AWS_PARTITION}:s3:::${STATE_BUCKET_NAME}/environments/${ENVIRONMENT}/terraform.tfstate"
    },
    {
      "Sid": "EnvironmentLockObjectCeiling",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:${AWS_PARTITION}:s3:::${STATE_BUCKET_NAME}/environments/${ENVIRONMENT}/terraform.tfstate.tflock"
    },
    {
      "Sid": "LifecycleControlBucketCeiling",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:${AWS_PARTITION}:s3:::${STATE_BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "controls/${NAME_PREFIX}/${ENVIRONMENT}/*"
        }
      }
    },
    {
      "Sid": "LifecycleControlObjectCeiling",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:${AWS_PARTITION}:s3:::${STATE_BUCKET_NAME}/controls/${NAME_PREFIX}/${ENVIRONMENT}/*"
    },
    {
      "Sid": "ImageRepositoryCeiling",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": [
        "arn:${AWS_PARTITION}:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/${NAME_PREFIX}/web",
        "arn:${AWS_PARTITION}:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/${NAME_PREFIX}/api",
        "arn:${AWS_PARTITION}:ecr:${AWS_REGION}:${AWS_ACCOUNT_ID}:repository/${NAME_PREFIX}/ml"
      ]
    },
    {
      "Sid": "EcrAuthenticationCeiling",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "RuntimePassRoleCeiling",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:ListRoleTags", "iam:PassRole"],
      "Resource": [
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-task-execution",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-web-workload",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-api-workload",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-ml-workload"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "StaticIamAttestationCeiling",
      "Effect": "Allow",
      "Action": [
        "iam:GetLoginProfile",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:GetRole",
        "iam:GetUser",
        "iam:ListAccessKeys",
        "iam:ListAttachedRolePolicies",
        "iam:ListAttachedUserPolicies",
        "iam:ListEntitiesForPolicy",
        "iam:ListGroupsForUser",
        "iam:ListPolicyTags",
        "iam:ListPolicyVersions",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:ListUserPolicies"
      ],
      "Resource": [
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:user/ReactorFrontNoel",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-*",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolio*"
      ]
    },
    {
      "Sid": "SchedulerPassRoleCeiling",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-scheduler",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DestroyRoleAssumptionCeiling",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-destroy"
    }
  ]
}
