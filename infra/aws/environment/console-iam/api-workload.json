{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApplicationObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:${AWS_PARTITION}:s3:::${NAME_PREFIX}-${ENVIRONMENT}-documents"
    },
    {
      "Sid": "ManageApplicationObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:${AWS_PARTITION}:s3:::${NAME_PREFIX}-${ENVIRONMENT}-documents/*"
    }
  ]
}
