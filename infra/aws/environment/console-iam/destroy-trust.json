{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExactOperatorController",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-operator-deployment",
          "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-codebuild-destroy"
        ]
      },
      "Action": "sts:AssumeRole"
    }
  ]
}
