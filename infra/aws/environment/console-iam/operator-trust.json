{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExactNoelDeploymentUser",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:user/ReactorFrontNoel",
          "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-automation"
        ]
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {"aws:PrincipalAccount": "${AWS_ACCOUNT_ID}"}
      }
    }
  ]
}
