{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExactOwnerPrincipal",
      "Effect": "Allow",
      "Principal": {"AWS": "${OWNER_PRINCIPAL_ARN}"},
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {"aws:PrincipalAccount": "${AWS_ACCOUNT_ID}"}
      }
    }
  ]
}
