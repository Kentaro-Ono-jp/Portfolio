{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadExactDeploymentSourceIdentity",
      "Effect": "Allow",
      "Action": [
        "iam:GetLoginProfile",
        "iam:GetUser",
        "iam:ListAccessKeys",
        "iam:ListAttachedUserPolicies",
        "iam:ListGroupsForUser",
        "iam:ListUserPolicies"
      ],
      "Resource": "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:user/ReactorFrontNoel"
    },
    {
      "Sid": "ReadExactPersistentRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-automation",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-operator-deployment",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-task-execution",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-web-workload",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-api-workload",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-ml-workload",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-destroy",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-scheduler",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-codebuild-image",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:role/${NAME_PREFIX}-${ENVIRONMENT}-codebuild-destroy"
      ]
    },
    {
      "Sid": "ReadExactPersistentManagedPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListEntitiesForPolicy",
        "iam:ListPolicyTags",
        "iam:ListPolicyVersions"
      ],
      "Resource": [
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioAutomation",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioAutomationBoundary",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioNoelAssumeBillingReadRole",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioNoelDeploymentAssumeOperator",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioNoelAssumeObserverRole",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioOperatorPermissionsMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioStaticIamAttestationMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioManagedEnvironmentPermissionsMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioManagedEnvironmentResourcePermissionsMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioOperatorBoundaryMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioTaskExecutionPolicyMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioApiWorkloadPolicyMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioMlWorkloadPolicyMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioDestroyPolicyMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioLifecycleControlPolicyMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioLifecycleDestroyPolicyMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioSchedulerPolicyMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioCodeBuildImagePolicyMonthly",
        "arn:${AWS_PARTITION}:iam::${AWS_ACCOUNT_ID}:policy/ReactorFrontPortfolioCodeBuildDestroyPolicyMonthly"
      ]
    }
  ]
}
